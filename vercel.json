{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/",
      "headers": { "cache-control": "no-store, max-age=0, must-revalidate" },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": { "cache-control": "no-store, max-age=0, must-revalidate" }
    }
  ]
}
